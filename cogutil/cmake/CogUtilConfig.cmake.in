@PACKAGE_INIT@
set(COGUTIL_VERSION "@SEMANTIC_VERSION@")

set(COGUTIL_INCLUDE_DIR "@CMAKE_INSTALL_PREFIX@/include")
set(COGUTIL_DATA_DIR   "@DATADIR@")
set(_COGUTIL_SHARED_LIBRARY "@CMAKE_INSTALL_PREFIX@/lib@LIB_DIR_SUFFIX@/opencog/libcogutil@CMAKE_SHARED_LIBRARY_SUFFIX@")
set(_COGUTIL_STATIC_LIBRARY "@CMAKE_INSTALL_PREFIX@/lib@LIB_DIR_SUFFIX@/opencog/libcogutil@CMAKE_STATIC_LIBRARY_SUFFIX@")

if(EXISTS "${_COGUTIL_SHARED_LIBRARY}")
    set(COGUTIL_LIBRARY "${_COGUTIL_SHARED_LIBRARY}")
elseif(EXISTS "${_COGUTIL_STATIC_LIBRARY}")
    set(COGUTIL_LIBRARY "${_COGUTIL_STATIC_LIBRARY}")
else()
    set(COGUTIL_LIBRARY "${_COGUTIL_SHARED_LIBRARY}")
endif()

if(NOT TARGET cogutil)
    add_library(cogutil UNKNOWN IMPORTED)
    set_target_properties(cogutil PROPERTIES
        IMPORTED_LOCATION "${COGUTIL_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${COGUTIL_INCLUDE_DIR}")
endif()

set(COGUTIL_FOUND 1)
